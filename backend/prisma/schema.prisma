
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
  BUYER
  SELLER
}

enum ListingType {
  LAND
  HOUSE
  CAR
}

enum ListingTransaction {
  RENT
  SALE
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
  SOLD
}

enum DealStatus {
  INTERESTED
  NEGOTIATION
  SALE_AGREEMENT
  SALE_COMPLETED
  DISPUTED
}

enum Currency {
  RWF
  KES
}

enum CommissionStatus {
  PENDING
  PAID
  WAIVED
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  country      String
  contact      String    @unique
  passwordHash String
  role         UserRole  @default(BUYER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  listings     Listing[] @relation("SellerListings")
  buyerDeals   Deal[]    @relation("BuyerDeals")
  sellerDeals  Deal[]    @relation("SellerDeals")
  messages     Message[]
}

model Listing {
  id              String             @id @default(cuid())
  code            String             @unique
  type            ListingType
  transactionType ListingTransaction @default(SALE)
  title           String
  country         String
  province        String
  district        String
  locality        String
  price           Decimal            @db.Decimal(18, 2)
  currency        Currency
  description     String
  details         Json?
  status          ListingStatus      @default(PENDING)
  sellerId        String
  seller          User               @relation("SellerListings", fields: [sellerId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  deals           Deal[]
  images          ListingImage[]
  videos          ListingVideo[]

  @@index([status, country, type])
  @@index([transactionType, status])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  publicId  String   @unique
  format    String?
  bytes     Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
}

model ListingVideo {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  publicId  String   @unique
  format    String?
  bytes     Int?
  duration  Float?
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
}

model Deal {
  id               String     @id @default(cuid())
  code             String     @unique
  listingId        String
  listing          Listing    @relation(fields: [listingId], references: [id])
  buyerId          String
  buyer            User       @relation("BuyerDeals", fields: [buyerId], references: [id])
  sellerId         String
  seller           User       @relation("SellerDeals", fields: [sellerId], references: [id])
  price            Decimal    @db.Decimal(18, 2)
  currency         Currency
  status           DealStatus @default(INTERESTED)
  commissionRate   Decimal    @default(0.05) @db.Decimal(5, 4)
  commissionAmount Decimal    @db.Decimal(18, 2)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  commission       Commission?

  @@index([status])
}

model Commission {
  id        String           @id @default(cuid())
  dealId    String           @unique
  deal      Deal             @relation(fields: [dealId], references: [id])
  amount    Decimal          @db.Decimal(18, 2)
  currency  Currency
  status    CommissionStatus @default(PENDING)
  paidAt    DateTime?
  reference String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String?
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
